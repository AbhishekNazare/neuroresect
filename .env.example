# Local defaults. Copy to .env if using Docker Compose.
DATABASE_URL=sqlite:///./data/neuroresect.db
JOB_EXECUTOR=local
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Docker services override DATABASE_URL and API_URL with internal service names.
POSTGRES_PASSWORD=neuroresect-local-only
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
